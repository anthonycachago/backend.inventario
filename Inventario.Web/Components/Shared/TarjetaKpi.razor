<div class="card kpi h-100 border-start border-4 border-@Color">
    <div class="card-body d-flex align-items-center gap-3">
        <div class="kpi-icono text-@Color"><i class="bi @Icono"></i></div>
        <div class="text-truncate">
            <div class="text-body-secondary small text-truncate">@Titulo</div>
            <div class="fs-4 fw-semibold">@Valor</div>
            @if (!string.IsNullOrEmpty(Detalle))
            {
                <div class="small text-body-secondary text-truncate">@Detalle</div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string Titulo { get; set; } = string.Empty;
    [Parameter] public string Valor { get; set; } = string.Empty;
    [Parameter] public string? Detalle { get; set; }
    [Parameter] public string Icono { get; set; } = "bi-box";
    [Parameter] public string Color { get; set; } = "primary";
}
