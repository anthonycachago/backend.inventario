@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 gap-2">
            <span class="text-body-secondary small me-auto d-none d-md-inline">
                <i class="bi bi-snow2"></i> Inventario y localización · Productos del mar
            </span>
            <TemaToggle />
        </div>

        <article class="content px-4 pb-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>
