@page "/ventas/nueva"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject VentasService Ventas
@inject NavigationManager Nav

<PageTitle>Nueva venta</PageTitle>

<div class="page-header">
    <h1><i class="bi bi-cart-plus"></i> Nueva venta</h1>
    <a class="btn btn-outline-secondary" href="ventas"><i class="bi bi-list-ul"></i> Ventas</a>
</div>

<Mensaje @bind-Texto="mensaje" Tipo="danger" />

<div class="row g-3">
    <div class="col-xl-8">
        <div class="card mb-3">
            <div class="card-header fw-semibold">1. Cliente y bodega</div>
            <div class="card-body row g-3">
                <div class="col-md-7">
                    <label class="form-label">Cliente *</label>
                    <div class="input-group">
                        <input class="form-control" style="max-width:40%" placeholder="Filtrar…" @bind="filtroCliente" @bind:event="oninput" />
                        <select class="form-select" @bind="modelo.ClienteId" @bind:after="CambioCliente">
                            <option value="0">— Seleccione —</option>
                            @foreach (var c in ClientesFiltrados)
                            {
                                <option value="@c.Id">@c.RazonSocial (@c.Identificacion)</option>
                            }
                        </select>
                    </div>
                    @if (Cliente is not null)
                    {
                        <div class="form-text">
                            @if (Cliente.LimiteCredito > 0)
                            {
                                <span>Crédito @Cliente.LimiteCredito.ToString("C2") a @Cliente.DiasCredito días · saldo actual <strong>@saldoCliente.ToString("C2")</strong> · disponible <strong>@((Cliente.LimiteCredito - saldoCliente).ToString("C2"))</strong></span>
                                @if (clienteConVencidas)
                                {
                                    <div class="text-danger fw-semibold"><i class="bi bi-exclamation-triangle-fill"></i> Tiene facturas vencidas: solo puede comprar de contado.</div>
                                }
                            }
                            else
                            {
                                <span>Cliente solo de contado.</span>
                            }
                        </div>
                    }
                    <div class="form-text"><a href="ventas/clientes" target="_blank">Registrar cliente nuevo</a></div>
                </div>
                <div class="col-md-5">
                    <label class="form-label">Despachar desde</label>
                    <select class="form-select" @bind="modelo.BodegaId" @bind:after="CargarStockAsync">
                        <option value="">Cualquier bodega (FEFO global)</option>
                        @foreach (var b in bodegas)
                        {
                            <option value="@b.Id">@b.Codigo · @b.Nombre</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header fw-semibold">2. Productos</div>
            <div class="card-body">
                <div class="row g-2 align-items-end mb-3">
                    <div class="col-md-5">
                        <label class="form-label small mb-0">Producto</label>
                        <select class="form-select" @bind="nuevaLinea.ProductoId" @bind:after="CambioProducto">
                            <option value="0">— Seleccione —</option>
                            @foreach (var p in productos)
                            {
                                <option value="@p.Id" disabled="@(Disponible(p.Id) <= 0)">@p.Nombre @p.Presentacion (@Disponible(p.Id).ToString("N1") @p.UnidadMedida.Abreviatura())</option>
                            }
                        </select>
                    </div>
                    <div class="col-4 col-md-2">
                        <label class="form-label small mb-0">Cantidad</label>
                        <input type="number" step="0.001" min="0" class="form-control" @bind="nuevaLinea.Cantidad" />
                    </div>
                    <div class="col-4 col-md-3">
                        <label class="form-label small mb-0">Precio unit. ($)</label>
                        <input type="number" step="0.0001" min="0" class="form-control" @bind="nuevaLinea.PrecioUnitario" />
                    </div>
                    <div class="col-4 col-md-2">
                        <button class="btn btn-outline-primary w-100" @onclick="AgregarLinea"><i class="bi bi-plus-lg"></i> Agregar</button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>Producto</th><th class="num">Cantidad</th><th class="num">Precio</th><th class="num">IVA</th><th class="num">Subtotal</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var l in modelo.Lineas)
                            {
                                var p = Producto(l.ProductoId);
                                <tr>
                                    <td>@p.Nombre @p.Presentacion</td>
                                    <td class="num">@l.Cantidad.ToString("N3") @p.UnidadMedida.Abreviatura()</td>
                                    <td class="num">@l.PrecioUnitario.ToString("C4")</td>
                                    <td class="num">@p.TarifaIva.ToString("0")%</td>
                                    <td class="num">@ReglasVentas.SubtotalLinea(l.Cantidad, l.PrecioUnitario).ToString("C2")</td>
                                    <td class="text-end"><button class="btn btn-sm btn-outline-danger" @onclick="() => modelo.Lineas.Remove(l)"><i class="bi bi-x-lg"></i></button></td>
                                </tr>
                            }
                            @if (modelo.Lineas.Count == 0)
                            {
                                <tr><td colspan="6" class="text-center text-body-secondary py-3">Agregue productos a la venta.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="card mb-3">
            <div class="card-header fw-semibold">3. Totales</div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between"><span>Subtotal 0 %</span><span class="num">@Totales.Subtotal0.ToString("C2")</span></li>
                <li class="list-group-item d-flex justify-content-between"><span>Subtotal con IVA</span><span class="num">@Totales.SubtotalIva.ToString("C2")</span></li>
                <li class="list-group-item d-flex justify-content-between"><span>IVA</span><span class="num">@Totales.Iva.ToString("C2")</span></li>
                <li class="list-group-item d-flex justify-content-between fs-5 fw-semibold"><span>Total</span><span class="num">@Totales.Total.ToString("C2")</span></li>
            </ul>
        </div>

        <div class="card">
            <div class="card-header fw-semibold">4. Pago</div>
            <div class="card-body">
                <div class="btn-group w-100 mb-3" role="group">
                    <input type="radio" class="btn-check" name="condicion" id="cond-contado" checked="@(modelo.CondicionPago == CondicionPago.Contado)"
                           @onchange="() => CambiarCondicion(CondicionPago.Contado)" />
                    <label class="btn btn-outline-primary" for="cond-contado"><i class="bi bi-cash-stack"></i> Contado</label>
                    <input type="radio" class="btn-check" name="condicion" id="cond-credito" checked="@(modelo.CondicionPago == CondicionPago.Credito)"
                           disabled="@(!PuedeCredito)" @onchange="() => CambiarCondicion(CondicionPago.Credito)" />
                    <label class="btn btn-outline-primary" for="cond-credito"><i class="bi bi-journal-bookmark"></i> A crédito</label>
                </div>

                @foreach (var pago in modelo.Pagos)
                {
                    <div class="border rounded p-2 mb-2 position-relative">
                        @if (modelo.Pagos.Count > 1 || modelo.CondicionPago == CondicionPago.Credito)
                        {
                            <button type="button" class="btn-close position-absolute top-0 end-0 m-1" style="font-size:.6rem" aria-label="Quitar pago"
                                    @onclick="() => modelo.Pagos.Remove(pago)"></button>
                        }
                        <PagoCampos Pago="pago" Sugerido="@(Pendiente + pago.Monto)" />
                    </div>
                }

                <button type="button" class="btn btn-sm btn-link px-0" @onclick="AgregarPago">
                    <i class="bi bi-plus-circle"></i> @(modelo.CondicionPago == CondicionPago.Credito ? "Agregar abono inicial" : "Agregar otra forma de pago")
                </button>

                <div class="d-flex justify-content-between small mt-2">
                    <span>Pagado</span><span class="num">@Pagado.ToString("C2")</span>
                </div>
                <div class="d-flex justify-content-between fw-semibold @(Pendiente == 0 ? "text-success" : modelo.CondicionPago == CondicionPago.Contado ? "text-danger" : "")">
                    <span>@(modelo.CondicionPago == CondicionPago.Credito ? "Queda por cobrar" : "Falta")</span><span class="num">@Pendiente.ToString("C2")</span>
                </div>
                @if (modelo.CondicionPago == CondicionPago.Credito && Cliente is not null)
                {
                    <div class="form-text">Vence el @DateTime.Today.AddDays(Cliente.DiasCredito).ToString("dd/MM/yyyy")</div>
                }

                <div class="mt-3">
                    <label class="form-label small mb-0">Observación</label>
                    <textarea class="form-control form-control-sm" rows="2" maxlength="250" @bind="modelo.Observacion"></textarea>
                </div>

                <button class="btn btn-success w-100 mt-3" @onclick="Registrar" disabled="@(guardando || modelo.Lineas.Count == 0 || modelo.ClienteId == 0)">
                    <i class="bi bi-check2-circle"></i> Registrar venta @Totales.Total.ToString("C2")
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private VentaModel modelo = new() { Pagos = [new PagoModel()] };
    private LineaVentaModel nuevaLinea = new();
    private List<Cliente> clientes = [];
    private List<Producto> productos = [];
    private List<Bodega> bodegas = [];
    private Dictionary<int, decimal> stock = [];
    private string filtroCliente = string.Empty;
    private decimal saldoCliente;
    private bool clienteConVencidas;
    private bool guardando;
    private string? mensaje;

    private Cliente? Cliente => clientes.FirstOrDefault(c => c.Id == modelo.ClienteId);
    private bool PuedeCredito => Cliente is { LimiteCredito: > 0, DiasCredito: > 0 } && !clienteConVencidas;
    private Producto Producto(int id) => productos.First(p => p.Id == id);

    private IEnumerable<Cliente> ClientesFiltrados => string.IsNullOrWhiteSpace(filtroCliente)
        ? clientes
        : clientes.Where(c => c.Id == modelo.ClienteId
                           || c.RazonSocial.Contains(filtroCliente, StringComparison.OrdinalIgnoreCase)
                           || c.Identificacion.Contains(filtroCliente));

    private TotalesVenta Totales => ReglasVentas.Calcular(modelo.Lineas.Select(l => (l.Cantidad, l.PrecioUnitario, Producto(l.ProductoId).TarifaIva)));
    private decimal Pagado => modelo.Pagos.Sum(p => p.Monto);
    private decimal Pendiente => Math.Max(0, Totales.Total - Pagado);

    // Stock vendible = lo que el despacho FEFO puede tomar, menos lo ya agregado a la venta
    private decimal Disponible(int productoId) =>
        stock.GetValueOrDefault(productoId) - modelo.Lineas.Where(l => l.ProductoId == productoId).Sum(l => l.Cantidad);

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        clientes = await db.Clientes.AsNoTracking().Where(c => c.Activo).OrderBy(c => c.RazonSocial).ToListAsync();
        productos = await db.Productos.AsNoTracking().Where(p => p.Activo).OrderBy(p => p.Nombre).ToListAsync();
        bodegas = await db.Bodegas.AsNoTracking().Where(b => b.Activo).OrderBy(b => b.Codigo).ToListAsync();
        await CargarStockAsync();
    }

    private async Task CargarStockAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var cuarentena = TipoUbicacion.Cuarentena.ToString();
        stock = await db.StockPorUbicacion.AsNoTracking()
            .Where(s => s.DiasParaVencer >= 0 && s.TipoUbicacion != cuarentena && (modelo.BodegaId == null || s.BodegaId == modelo.BodegaId))
            .GroupBy(s => s.ProductoId)
            .Select(g => new { g.Key, Cantidad = g.Sum(s => s.Cantidad) })
            .ToDictionaryAsync(x => x.Key, x => x.Cantidad);
    }

    private async Task CambioCliente()
    {
        saldoCliente = 0;
        clienteConVencidas = false;
        if (Cliente is not null)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var hoy = DateTime.Today;
            var pendientes = await db.Ventas.Where(v => v.ClienteId == modelo.ClienteId && v.Saldo > 0)
                .Select(v => new { v.Saldo, v.FechaVencimiento }).ToListAsync();
            saldoCliente = pendientes.Sum(v => v.Saldo);
            clienteConVencidas = pendientes.Any(v => v.FechaVencimiento < hoy);
        }
        if (!PuedeCredito) CambiarCondicion(CondicionPago.Contado);
    }

    private void CambioProducto()
    {
        if (nuevaLinea.ProductoId != 0) nuevaLinea.PrecioUnitario = Producto(nuevaLinea.ProductoId).PrecioVenta;
    }

    private void AgregarLinea()
    {
        mensaje = null;
        if (nuevaLinea.ProductoId == 0 || nuevaLinea.Cantidad <= 0)
        {
            mensaje = "Seleccione un producto e ingrese una cantidad mayor a 0.";
            return;
        }
        if (nuevaLinea.Cantidad > Disponible(nuevaLinea.ProductoId))
        {
            mensaje = $"Solo hay {Disponible(nuevaLinea.ProductoId):N3} disponibles para despacho.";
            return;
        }
        modelo.Lineas.Add(nuevaLinea);
        nuevaLinea = new LineaVentaModel();
    }

    private void CambiarCondicion(CondicionPago condicion)
    {
        modelo.CondicionPago = condicion;
        // Contado arranca con un pago; crédito sin abono inicial
        modelo.Pagos = condicion == CondicionPago.Contado ? [new PagoModel()] : [];
    }

    private void AgregarPago() => modelo.Pagos.Add(new PagoModel());

    private async Task Registrar()
    {
        guardando = true;
        mensaje = null;
        try
        {
            // Pagos vacíos agregados por error no cuentan
            modelo.Pagos.RemoveAll(p => p.Monto == 0);
            var venta = await Ventas.RegistrarVentaAsync(modelo);
            Nav.NavigateTo($"ventas/{venta.Id}?nueva=1");
        }
        catch (ReglaNegocioException ex)
        {
            mensaje = ex.Message;
            if (modelo.CondicionPago == CondicionPago.Contado && modelo.Pagos.Count == 0) modelo.Pagos.Add(new PagoModel());
        }
        finally
        {
            guardando = false;
        }
    }
}
