@page "/inventario/despacho"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject InventarioService Inventario

<PageTitle>Despacho FEFO</PageTitle>

<div class="page-header">
    <h1><i class="bi bi-truck"></i> Despacho FEFO</h1>
</div>
<p class="text-body-secondary">
    Despacha un producto consumiendo primero los lotes con vencimiento más próximo (First Expired, First Out).
    No toma stock vencido ni en cuarentena.
</p>

<Mensaje @bind-Texto="mensaje" Tipo="@tipoMensaje" />

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-body">
                <EditForm Model="modelo" OnValidSubmit="Despachar">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label">Producto *</label>
                        <InputSelect class="form-select" @bind-Value="modelo.ProductoId" @bind-Value:after="CargarDisponibleAsync">
                            <option value="0">— Seleccione —</option>
                            @foreach (var p in productos)
                            {
                                <option value="@p.ProductoId">@p.Codigo · @p.Producto (@p.StockTotal.ToString("N3") @Textos.Abreviatura(p.UnidadMedida))</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => modelo.ProductoId" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Bodega</label>
                        <InputSelect class="form-select" @bind-Value="modelo.BodegaId" @bind-Value:after="CargarDisponibleAsync">
                            <option value="">Cualquier bodega</option>
                            @foreach (var b in bodegas)
                            {
                                <option value="@b.Id">@b.Codigo · @b.Nombre</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Cantidad *</label>
                        <InputNumber class="form-control" @bind-Value="modelo.Cantidad" step="0.001" min="0" />
                        <ValidationMessage For="() => modelo.Cantidad" />
                        @if (modelo.ProductoId != 0)
                        {
                            <div class="form-text">Disponible para despacho: <strong>@Disponible.ToString("N3")</strong></div>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Referencia</label>
                        <InputText class="form-control" @bind-Value="modelo.Referencia" maxlength="50" placeholder="Factura, pedido…" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Observación</label>
                        <InputTextArea class="form-control" rows="2" @bind-Value="modelo.Observacion" maxlength="250" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100" disabled="@guardando"><i class="bi bi-truck"></i> Despachar</button>
                </EditForm>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        @if (resultado is not null)
        {
            <div class="card mb-3 border-success">
                <div class="card-header fw-semibold text-success"><i class="bi bi-check2-all"></i> Lotes consumidos</div>
                <table class="table table-sm mb-0">
                    <thead><tr><th>Lote</th><th>Ubicación</th><th>Vence</th><th class="num">Cantidad</th></tr></thead>
                    <tbody>
                        @foreach (var c in resultado)
                        {
                            <tr><td><code>@c.Lote</code></td><td>@c.Ubicacion</td><td>@c.FechaVencimiento.ToString("dd/MM/yyyy")</td><td class="num">@c.Cantidad.ToString("N3")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="card">
            <div class="card-header fw-semibold">Orden de consumo previsto</div>
            <div class="table-responsive tabla-scroll">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead><tr><th>#</th><th>Lote</th><th>Ubicación</th><th>Vencimiento</th><th class="num">Cantidad</th></tr></thead>
                    <tbody>
                        @{ var i = 0; }
                        @foreach (var s in disponibles)
                        {
                            i++;
                            <tr>
                                <td>@i</td>
                                <td><code>@s.Lote</code></td>
                                <td>@s.Bodega · @s.Ubicacion</td>
                                <td>@s.FechaVencimiento.ToString("dd/MM/yyyy") <EstadoVencimiento Dias="s.DiasParaVencer" /></td>
                                <td class="num">@s.Cantidad.ToString("N3")</td>
                            </tr>
                        }
                        @if (disponibles.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-body-secondary py-4">Seleccione un producto con stock.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private SalidaFefoModel modelo = new();
    private List<StockProductoVista> productos = [];
    private List<Bodega> bodegas = [];
    private List<StockUbicacionVista> disponibles = [];
    private List<ConsumoFefo>? resultado;
    private bool guardando;
    private string? mensaje;
    private string tipoMensaje = "success";

    private decimal Disponible => disponibles.Sum(d => d.Cantidad);

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        bodegas = await db.Bodegas.AsNoTracking().Where(b => b.Activo).OrderBy(b => b.Codigo).ToListAsync();
        await CargarProductosAsync();
    }

    private async Task CargarProductosAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        productos = await db.StockPorProducto.AsNoTracking().Where(p => p.StockTotal > 0).OrderBy(p => p.Producto).ToListAsync();
    }

    // Misma regla que InventarioService.RegistrarSalidaFefoAsync, para previsualizar.
    private async Task CargarDisponibleAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var cuarentena = TipoUbicacion.Cuarentena.ToString();
        disponibles = await db.StockPorUbicacion.AsNoTracking()
            .Where(s => s.ProductoId == modelo.ProductoId
                        && s.DiasParaVencer >= 0
                        && s.TipoUbicacion != cuarentena
                        && (modelo.BodegaId == null || s.BodegaId == modelo.BodegaId))
            .Join(db.Ubicaciones.Where(u => u.Activo), s => s.UbicacionId, u => u.Id, (s, u) => s)
            .OrderBy(s => s.FechaVencimiento).ThenBy(s => s.Cantidad)
            .ToListAsync();
    }

    private async Task Despachar()
    {
        guardando = true;
        try
        {
            resultado = await Inventario.RegistrarSalidaFefoAsync(modelo);
            (mensaje, tipoMensaje) = ($"Despacho registrado: {modelo.Cantidad:N3} en {resultado.Count} movimiento(s).", "success");
            modelo = new SalidaFefoModel { ProductoId = modelo.ProductoId, BodegaId = modelo.BodegaId };
            await CargarProductosAsync();
            await CargarDisponibleAsync();
        }
        catch (ReglaNegocioException ex)
        {
            (mensaje, tipoMensaje) = (ex.Message, "danger");
        }
        finally
        {
            guardando = false;
        }
    }
}
